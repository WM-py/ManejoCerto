# Variaveis de ambiente do Manejo Certo
# Copie este arquivo para .env e preencha com suas chaves reais.

# === Supabase ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# === Modo Preview (dev only) ===
# Quando true, usa um Supabase simulado em memoria com dados ficticios.
# DEIXE FALSE em producao.
VITE_PREVIEW_MOCK=false

# === Branding ===
VITE_APP_TITLE=Manejo Certo
VITE_APP_DESCRIPTION=Sistema de gestão financeira para pecuária de corte

# === Mercado Pago Checkout Preferences ===
# Crie preferências no Mercado Pago e cole os IDs abaixo.
VITE_MP_ANNUAL_PREFERENCE_ID=your_annual_preference_id_here
VITE_MP_LIFETIME_PREFERENCE_ID=your_lifetime_preference_id_here
# === Hero image for Landing page ===
# Path relative to the `public/` folder or a full URL. Defaults to `/login-bg.png`.
VITE_HERO_IMAGE=/login-bg.png
