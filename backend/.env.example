# Copie este arquivo para .env e preencha com valores reais.
# O .env já é ignorado pelo git — nunca versione chaves/tokens.

# --- IA (Fase POC) ---
OPENAI_API_KEY=sk-cole-sua-chave-aqui
# Opcional: modelo usado na extração (padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Opcional: modelo de transcrição de áudio (Fase 2, padrão: whisper-1)
OPENAI_WHISPER_MODEL=whisper-1
# Opcional: rendimento de carcaça (0-1) p/ converter arroba->peso vivo. Padrão 0.50.
RENDIMENTO_CARCACA=0.50

# --- WhatsApp Cloud API (Fase 1) ---
# Token que VOCÊ inventa; tem que ser igual ao cadastrado no painel da Meta.
WHATSAPP_VERIFY_TOKEN=um-segredo-qualquer-que-voce-escolhe
# Token de acesso do app (Meta > WhatsApp > API Setup).
WHATSAPP_TOKEN=
# ID do número de telefone (Meta > WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=
# Opcional: App Secret. Se preenchido, valida a assinatura dos webhooks.
WHATSAPP_APP_SECRET=
# Opcional: versão da Graph API (padrão v21.0).
WHATSAPP_API_VERSION=v21.0

# --- Supabase (Fase 3: gravação) ---
# URL do projeto (Supabase > Project Settings > API).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SERVICE ROLE key — SECRETA, só server-side. Ignora RLS. NUNCA no frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Dono dos registros (POC single-tenant): UUID do usuário em auth.users.
MANEJO_USER_ID=
